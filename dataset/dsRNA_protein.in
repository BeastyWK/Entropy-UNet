special_bonds lj/coul 0.0 1.0 1.0

neighbor    2.0 multi

### Energy minimization
minimize    1.0e-4 1.0e-6 1000 100000

### production ###

#### Time step
reset_timestep  0
timestep        ${dt} #ns

### Ensemble / Thermostat
run_style       verlet
velocity        all create $T ${seedV}

fix             fix1 all nve
fix             fix2 all langevin $T $T ${damp} ${seedT} 

### Outputting useful information in the log file
thermo          ${thermointrv}
thermo_style    custom step temp etotal evdwl ecoul ebond eangle

# Saving the simulation snapshots in a trajectory file
dump            mydump1 all custom ${dumpintrv} rna.dumplammps id type x y z
dump_modify     mydump1 sort id

# Specifying the runlength
#restart  ${runtime} restart.dsRNA
run             ${runtime}
write_data      an.*

# Writing restart files
run             ${runtime}
write_data      an.*

