###### VARIABLES #######
variable    T equal 300
variable    damp equal 1000
variable    seedV equal 4928421
variable    seedT equal 3278431
variable    dt equal 0.1
variable    thermointrv equal 100000
variable    dumpintrv equal 100000
variable    runtime equal 2000000000

###### BOX ############
units       nano
dimension   3
boundary    p p p
atom_style  full
read_data   RNA_protein_beads.data


###### Group ############
group      RNA type 1 2 3 4 5 6 7 8 9 
group      Protein type 10 11 12 13

###### pair styles ##########
bond_style  harmonic
angle_style cosine/squared

# pairwise coefficients  1--P   2--A  3--U  4--C 5--G

pair_style  hybrid lj1210rna/3bead 6.2 ljlambda 0.1 0 35.0 soft 25
dielectric  80.0


